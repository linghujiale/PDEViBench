# DOLFINx 0.9.0 environment for the finite-element panel.
#
# Build:
#   docker build -t pdevibench/dolfinx:0.9.0 -f docker/Dockerfile.dolfinx .
# Check:
#   docker run --rm pdevibench/dolfinx:0.9.0 python /opt/pdevibench/smoke/poisson_unit_square.py

FROM dolfinx/dolfinx:v0.9.0

LABEL org.opencontainers.image.title="pdevibench/dolfinx"
LABEL org.opencontainers.image.version="0.9.0"
LABEL org.opencontainers.image.description="DOLFINx 0.9.0 environment for PDEViBench"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN python -m pip install \
        "jsonschema==4.23.0" \
        "h5py==3.12.1" \
        "meshio==5.3.5" \
        "pyyaml==6.0.2" \
        "filelock==3.16.1" \
        "tqdm==4.66.5"

WORKDIR /opt/pdevibench

COPY docker/smoke/poisson_unit_square.py /opt/pdevibench/smoke/poisson_unit_square.py

RUN useradd -ms /bin/bash runner && chown -R runner:runner /opt/pdevibench
USER runner

ENTRYPOINT ["python"]
CMD ["-c", "import dolfinx; print('dolfinx', dolfinx.__version__)"]
